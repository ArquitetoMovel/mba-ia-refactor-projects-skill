# Obrigatorio em producao: segredo forte e unico por ambiente.
# Em DEBUG/TESTS um valor ausente ou fraco gera chave efemera com warning;
# em producao a aplicacao recusara subir (fail-fast).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=sqlite:///tasks.db
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# Optional SMTP (disabled by default)
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

TOKEN_MAX_AGE_SECONDS=86400

# Paginacao padrao dos endpoints de lista
DEFAULT_PER_PAGE=20
MAX_PER_PAGE=100
